# Database (PostgreSQL)
DATABASE_URL=postgres://root:password@localhost:5432/amazon_optimizer

# SQLite Database Path (Optional, for persisting data outside the project directory on a VPS)
# DB_PATH=/var/lib/optimus/optimus.db

# Database connection tuning
DATABASE_POOL_MAX=20
DATABASE_SSL_MODE=require

QDRANT_URL=http://localhost:6333

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-your-openai-api-key

# Paddle (payments)
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret
PADDLE_ENVIRONMENT=sandbox

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# API Key for admin / internal procedures (must be set in production)
API_KEY=your-super-secret-api-key-min-32-chars

# Kimi OAuth
VITE_KIMI_AUTH_URL=https://auth.yourdomain.com
VITE_APP_ID=your-kimi-app-id
VITE_KIMI_AUTH_CLIENT_ID=your-kimi-client-id
KIMI_AUTH_CLIENT_SECRET=your-kimi-client-secret

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_VERSION=1.0.0

# CORS (comma-separated list; defaults to "*" in development, empty in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# External APIs
APOLLO_API_KEY=your-apollo-api-key
RESEND_API_KEY=your-resend-api-key
RAINFOREST_API_KEY=your-rainforest-api-key
APIFY_API_TOKEN=your-apify-api-token

# Notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
TRACKING_WEBHOOK_URL=https://hooks.yourdomain.com/tracking

# Client config
VITE_CALENDLY_URL=https://calendly.com/optimusrufus

# Sentry Monitoring
SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
SENTRY_AUTH_TOKEN=sntrys_your_auth_token
VITE_SENTRY_DSN=${SENTRY_DSN}
VITE_APP_VERSION=${APP_VERSION}
